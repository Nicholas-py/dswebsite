{
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "module": "esnext",
    "target": "es2020",
    "allowJs": true,
    "moduleResolution": "node",
    "preserveSymlinks": true,
    "baseUrl": ".",
    "paths": {
      "@xterm/xterm": ["vendor/xterm-fork"],
      "@xterm/addon-webgl": ["vendor/xterm-fork/addons/addon-webgl"],
      "@xterm/addon-fit": ["vendor/xterm-fork/addons/addon-fit"]
    }

  },
  "files": ["src/index.ts","src/declarations.d.ts"]
}
